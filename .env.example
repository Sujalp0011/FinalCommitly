# ── Database ──────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=

# ── NextAuth ──────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Set to your production URL on Vercel (e.g. https://commitly.vercel.app)
NEXTAUTH_URL=

# ── GitHub OAuth ──────────────────────────────────
# Create at: https://github.com/settings/developers
# Set callback URL to: https://your-domain.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Groq AI ───────────────────────────────────────
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=
